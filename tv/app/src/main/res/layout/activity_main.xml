<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#141218">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 顶部导航栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvPath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="/"
                android:textColor="#D0BCFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:ellipsize="start"
                android:singleLine="true"/>

            <Button
                android:id="@+id/btnUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="返回上级"
                android:background="@drawable/selector_btn"
                android:textColor="#381E72"
                android:textSize="16sp"
                android:padding="12dp"
                android:layout_marginRight="16dp"
                android:focusable="true"/>

            <Button
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全局搜索"
                android:background="@drawable/selector_btn"
                android:textColor="#381E72"
                android:textSize="16sp"
                android:padding="12dp"
                android:layout_marginRight="16dp"
                android:focusable="true"/>

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="连接设置"
                android:background="@drawable/selector_btn"
                android:textColor="#381E72"
                android:textSize="16sp"
                android:padding="12dp"
                android:focusable="true"/>
        </LinearLayout>

        <!-- 文件列表 (RecyclerView 替代 ListView) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="40dp"
            android:focusable="true" />
    </LinearLayout>

    <!-- 底部协同提示 -->
    <TextView
        android:id="@+id/tvSyncHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:text="手机协同服务已开启"
        android:textColor="#938F99"
        android:textSize="14sp" />

    <!-- 搜索全屏浮层 -->
    <LinearLayout
        android:id="@+id/searchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#141218"
        android:visibility="gone"
        android:padding="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            
            <Button
                android:id="@+id/btnBackFromSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="退出搜索"
                android:background="@drawable/selector_btn"
                android:textColor="#381E72"
                android:padding="12dp"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvSearchInput"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="#2B2930"
                android:textColor="#E6E0E9"
                android:textSize="24sp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginLeft="16dp"
                android:text="|" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/keyboardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:focusable="false" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchResults"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:focusable="true" />
    </LinearLayout>
</FrameLayout>
