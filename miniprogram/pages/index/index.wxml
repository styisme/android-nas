<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-input" placeholder="全局搜索文件..." value="{{searchQuery}}" bindinput="onSearchInput" bindconfirm="doSearch" />
    <button class="btn-search" bindtap="doSearch">搜索</button>
  </view>

  <!-- 提示信息 -->
  <view class="path-display" wx:if="{{currentPath !== '/'}}">当前路径: {{currentPath}}</view>

  <!-- 文件列表 -->
  <view class="file-list">
    <view class="file-item" wx:for="{{files}}" wx:key="name" bindtap="onFileClick" data-item="{{item}}">
      <text class="icon">{{item.dir ? '📁' : '📄'}}</text>
      <view class="info">
        <text class="name">{{item.name}}</text>
        <text class="size" wx:if="{{!item.dir}}">{{item.size}} B</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
  
  <view class="empty-state" wx:if="{{files.length === 0}}">空空如也</view>
</view>

<!-- 底部操作面板 (Modal) -->
<view class="modal-mask" wx:if="{{showAction}}" bindtap="closeAction"></view>
<view class="action-sheet" wx:if="{{showAction}}">
  <view class="action-title">{{selectedFile.name}}</view>
  <button class="action-btn" bindtap="shareLink" wx:if="{{!selectedFile.dir}}">🔗 复制免密分享链接</button>
  <button class="action-btn" bindtap="openWebConsole">🦅 打开 Web 控制台</button>
  <button class="action-btn" bindtap="showClipboard">📋 局域网剪贴板</button>
  <button class="action-btn cancel" bindtap="closeAction">取消</button>
</view>

<!-- 剪贴板弹窗 -->
<view class="modal-mask" wx:if="{{showClipboardModal}}" bindtap="closeClipboard"></view>
<view class="clipboard-modal" wx:if="{{showClipboardModal}}">
  <view class="clip-title">局域网剪贴板</view>
  <textarea class="clip-textarea" value="{{clipboardText}}" bindinput="onClipInput" placeholder="输入要同步的文字..."></textarea>
  <view class="clip-actions">
    <button class="btn-cancel" bindtap="closeClipboard">取消</button>
    <button class="btn-save" bindtap="saveClipboard">保存到 NAS</button>
  </view>
</view>
